# Auto detect text files and perform LF normalization
* text=auto

# `* text=auto` above guesses per file. Say it outright for the things that
# must never be line-ending normalised: the exe, the icon, and the generated
# PNGs the website serves.
*.exe binary
*.ico binary
*.png binary

# Generated by tools/make_brand.py and tools/make_ico.py. Marked so GitHub
# keeps them out of language stats and collapses them in diffs.
docs/assets/** linguist-generated=true
packaging/msix/Assets/** linguist-generated=true
CuteMute.ico linguist-generated=true

# Generated with LF and diffed against the checkout by .github/workflows/
# build.yml -- if git rewrote these to CRLF the check would fail every run.
*.svg text eol=lf
