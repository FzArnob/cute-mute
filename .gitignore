# Build output. dist/ carries the exe and the MSIX; the release is where
# users get them, so neither belongs in the repository.
release/
*.msix

# Regenerated by build.ps1 on every build, from its own command line, so a
# tracked copy just churns between --onefile and --onedir.
CuteMute.spec

# Local MSIX signing leftovers (tools/make_msix.ps1 -SelfSign).
test.cer
